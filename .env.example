# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# EVERY value here is optional. With none of them set, the project still runs:
# retrieval, all deterministic metrics, the full test suite, and the offline
# smoke evaluation work with no credentials at all. Keys are needed only to
# generate NEW model outputs; existing results replay from the response cache.

# --- generation and judging ---------------------------------------------------
# Free keys: https://aistudio.google.com/apikey
# Needed only to run the pipeline against cases whose responses are not yet
# cached. `rag-eval run` reports the cache hit rate so you can see whether a key
# will actually be used before you spend anything.
GEMINI_API_KEY=

# --- optional tracing ---------------------------------------------------------
# Braintrust is strictly additive. Local JSONL tracing in runs/<run_id>/trace.jsonl
# is always the default and is never disabled by this setting.
#
# When this is unset, `braintrust.init_logger()` is never called, so every
# @traced decorator resolves to a genuine no-op span: no network, no exception,
# no data leaves the machine.
#
# When it IS set, function inputs and outputs are serialised and uploaded --
# which for this project means questions, retrieved corpus text, and model
# answers. The corpus is synthetic so that is harmless here, but read
# docs/tracing.md before pointing this at anything real.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=rag-evaluation-lab

# --- paths (optional overrides) -----------------------------------------------
# Defaults to <repo>/cache. Point this at a scratch disk if space is tight.
RAG_EVAL_CACHE_DIR=

# --- offline enforcement ------------------------------------------------------
# Set to 1 to forbid all network access. In this mode the process DELETES the
# keys above from its own environment at startup, so a leaked key cannot cause
# a paid call, and any cache miss raises CacheMissError with the missing key,
# model, and prompt prefix rather than silently falling back to a stub.
#
# CI sets this to 1. Leave it unset for local development.
RAG_EVAL_OFFLINE=
